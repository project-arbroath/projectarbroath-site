        <div class="absolute bottom-0 left-0 right-0 h-1.5 bg-black/40 flex z-30">
            <div onclick="setConcept(1)" class="flex-1 h-full cursor-pointer relative border-r border-[#0f1a0e]/50">
                <div id="progress-bar-1" class="absolute top-0 left-0 h-full bg-amber w-0 transition-all duration-100 ease-linear"></div>
