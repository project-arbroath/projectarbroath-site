    <button type="button" onclick="prevConcept()" class="absolute -left-4 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/80 hover:bg-amber hover:text-[#0f1a0e] border border-cream/10 hover:border-transparent flex items-center justify-center text-cream z-40 shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-label="Previous card">
        &larr;
    </button>
    <button type="button" onclick="nextConcept()" class="absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/80 hover:bg-amber hover:text-[#0f1a0e] border border-cream/10 hover:border-transparent flex items-center justify-center text-cream z-40 shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-label="Next card">
        &rarr;
    </button>
</div>

<script>
    let currentConcept = 1;
    const TOTAL_CONCEPTS = 4;
    const SLIDE_DURATION = 6500;
    let autoplayActive = true;
    let lastTickTime = Date.now();
    let pauseActive = false;
    let animationFrameId = null;
    let slideProgress = 0;

    function resetProgressBars() {
        for (let i = 1; i <= TOTAL_CONCEPTS; i++) {
            const bar = document.getElementById(`progress-bar-${i}`);
            if (bar) bar.style.width = '0%';
        }
    }

    function setConcept(num) {
        currentConcept = num;
        slideProgress = 0;
        resetProgressBars();

        for (let i = 1; i <= TOTAL_CONCEPTS; i++) {
            const card = document.getElementById(`card-concept-${i}`);
            if (!card) continue;

            if (i === num) {
                card.classList.remove('opacity-0', 'scale-95');
                card.classList.add('opacity-100', 'scale-100', 'z-10');
                card.style.pointerEvents = 'auto';
            } else {
                card.classList.remove('opacity-100', 'scale-100', 'z-10');
                card.classList.add('opacity-0', 'scale-95', 'z-0');
                card.style.pointerEvents = 'none';
            }
        }
    }

    function nextConcept() {
        let nextNum = currentConcept + 1;
        if (nextNum > TOTAL_CONCEPTS) nextNum = 1;
        setConcept(nextNum);
    }

    function prevConcept() {
        let prevNum = currentConcept - 1;
        if (prevNum < 1) prevNum = TOTAL_CONCEPTS;
        setConcept(prevNum);
    }

    function pauseSpinner() {
        pauseActive = true;
    }

    function resumeSpinner() {
        pauseActive = false;
        lastTickTime = Date.now();
    }

    function updateSpinnerLoop() {
        if (autoplayActive && !pauseActive) {
            const now = Date.now();
            const delta = now - lastTickTime;
            lastTickTime = now;

            slideProgress += (delta / SLIDE_DURATION) * 100;

            if (slideProgress >= 100) {
                slideProgress = 0;
                nextConcept();
            } else {
                const activeBar = document.getElementById(`progress-bar-${currentConcept}`);
                if (activeBar) {
                    activeBar.style.width = `${slideProgress}%`;
                }
            }
        } else {
            lastTickTime = Date.now();
        }
        animationFrameId = requestAnimationFrame(updateSpinnerLoop);
    }

    document.addEventListener("DOMContentLoaded", function() {
        setConcept(1);
        updateSpinnerLoop();
    });
</script>
