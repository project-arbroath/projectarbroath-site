            </div>
            <div onclick="setConcept(3)" class="flex-1 h-full cursor-pointer relative border-r border-[#0f1a0e]/50">
                <div id="progress-bar-3" class="absolute top-0 left-0 h-full bg-amber w-0 transition-all duration-100 ease-linear"></div>
            </div>
            <div onclick="setConcept(4)" class="flex-1 h-full cursor-pointer relative">
